{
  "name": "gym-buddy",
  "private": true,
  "version": "0.1.0-beta.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "android:sync": "vite build && cap sync android",
    "android:open": "cap open android",
    "android:assets": "node scripts/generate-brand-assets.mjs && capacitor-assets generate --android --assetPath resources --iconBackgroundColor \"#1D4ED8\" --iconBackgroundColorDark \"#1D4ED8\" --splashBackgroundColor \"#030712\" --splashBackgroundColorDark \"#030712\"",
    "verify:bundle": "node scripts/verify-bundle.mjs",
    "proxy:deploy": "npx supabase@2 functions deploy ai-proxy --no-verify-jwt --project-ref ksxjmzesbwaijiocwbwx"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/camera": "^8.2.6",
    "@capacitor/core": "^8.6.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/network": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@fontsource/inter": "^5.3.0",
    "@google/genai": "^1.7.0",
    "@supabase/supabase-js": "^2.118.0",
    "dompurify": "^3.4.17",
    "marked": "^18.1.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^3.9.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.0",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.6.2",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
