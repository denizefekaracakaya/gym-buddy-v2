rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // users/{uid} holds { profile, logs, waterData } (see firebase-blueprint.json).
    // Only these three map fields are accepted, and the document stays under ~900 KB.
    function isValidUserDoc(data) {
      return data.keys().hasOnly(['profile', 'logs', 'waterData'])
        && (!('profile' in data) || data.profile is map)
        && (!('logs' in data) || data.logs is map)
        && (!('waterData' in data) || data.waterData is map);
    }

    match /users/{userId} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidUserDoc(request.resource.data);
    }

    // Everything else is denied by default.
  }
}
