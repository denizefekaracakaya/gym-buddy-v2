# All optional. Defaults point to the Gym Buddy Supabase project (supabase.config.ts).
# These values are PUBLIC (compiled into the app). NEVER put the Gemini key here.
# VITE_SUPABASE_URL=https://<ref>.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# VITE_AI_DISABLED=true

# The Gemini API key lives ONLY in Supabase:
#   Dashboard → Edge Functions → Secrets → GEMINI_API_KEY
