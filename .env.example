# Public URL of the AI proxy (server/ai-proxy). Leave empty to build with AI features disabled.
# This value is public (it is compiled into the app). NEVER put the Gemini key here.
VITE_AI_PROXY_URL=

# The Gemini API key lives ONLY on the server:
#   npx wrangler@4 secret put GEMINI_API_KEY --config server/ai-proxy/wrangler.toml
